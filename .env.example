# ─────────────────────────────────────────────────────────
# Aidos Bot — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────

# ── Telegram ──────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Google Gemini ──────────────────────────────────────────
# Get from https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-3.7-flash)
# GEMINI_MODEL=gemini-3.7-flash

# Dedicated Gemini model for thought journaling & audio notes (default: gemini-3.8-flash)
# JOURNAL_MODEL=gemini-3.8-flash

# ── Access Control ─────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to use the bot
# Find your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Comma-separated Telegram user IDs with admin privileges
# Admins can run /allow, /revoke, /users commands
ADMIN_USER_IDS=123456789

# ── Database ───────────────────────────────────────────────
# Path to SQLite database file (inside container: /app/data/aidos.db)
DATABASE_PATH=data/aidos.db

# ── Logging ────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── History ────────────────────────────────────────────────
# Maximum translation history entries per user (default: 1000)
# Oldest entries are deleted when cap is exceeded
# HISTORY_CAP=1000

# ── Google Sheets Sync (Optional) ──────────────────────────
# Spreadsheet ID from the Google Sheet URL (https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
# GOOGLE_SHEET_ID=your_spreadsheet_id_here
# Option A: Path to Google Cloud Service Account JSON key file (inside container: /app/credentials/service_account.json)
# GOOGLE_SHEETS_CREDENTIALS_FILE=/app/credentials/service_account.json
# Option B: Or paste the raw JSON key directly as a one-line string (no files to copy!)
# GOOGLE_SHEETS_CREDENTIALS_JSON='{"type": "service_account", ...}'


